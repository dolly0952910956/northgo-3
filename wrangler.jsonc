{
  "name": "northgo",
  "account_id": "d51faed2a0c431766613ef4fc100cf25",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo",
      "database_id": "ffd231d8-a7ab-4e3f-b489-8dbbd36ffed9",
      "migrations_dir": "migrations"
    }
  ]
}
